# Postgres
DATABASE_URL=postgres://postgres:postgres@localhost:5432/aesaas

# Redis
REDIS_URL=redis://localhost:6379

# Claude API
ANTHROPIC_API_KEY=sk-ant-...

# Worker auth (HTTP basic, v0.0.1 only)
BASIC_AUTH_USER=admin
BASIC_AUTH_PASS=changeme

# Logging
LOG_LEVEL=info

# P2 OpenRouter fallback for minimax
# 留空 OPENROUTER_API_KEY 即关闭 fallback（保持现状）
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_FALLBACK_MODEL=minimax/MiniMax-M3

# P0 POC: Creatomate SaaS + Azure TTS
# Set RUN_CREATOMATE_POC=1 在 worker instance 上启 POC 路径（默认 0 走旧 FFmpeg）
# CREATOMATE_API_KEY=
# CREATOMATE_BASE_URL=https://api.creatomate.com/v2
# CREATOMATE_TEMPLATE_ID=
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=eastasia
# RUN_CREATOMATE_POC=0

# P1 PR1: Trigger.dev v4 self-hosted (introduced, NOT wired yet)
# 留空时 lib/trigger.ts 的 getTriggerSdk() 会拒载 — BullMQ 仍默认 active
# TRIGGER_PROJECT_REF=
# TRIGGER_SECRET_KEY=
# TRIGGER_API_URL=http://trigger-web:3030
# TRIGGER_DEPLOYMENT=self-hosted
# RUN_TRIGGER_DEV=0
