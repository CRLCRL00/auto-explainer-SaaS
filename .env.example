# Postgres
DATABASE_URL=postgres://postgres:postgres@localhost:5432/aesaas

# Redis
REDIS_URL=redis://localhost:6379

# Claude API
ANTHROPIC_API_KEY=sk-ant-...

# Worker auth (HTTP basic, v0.0.1 only)
BASIC_AUTH_USER=admin
BASIC_AUTH_PASS=changeme

# Logging
LOG_LEVEL=info

# P2 OpenRouter fallback for minimax
# 留空 OPENROUTER_API_KEY 即关闭 fallback（保持现状）
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_FALLBACK_MODEL=minimax/MiniMax-M3

# P0 全量: Creatomate SaaS 是默认 render path, CREATOMATE_API_KEY 必须配.
# 部署前先在 Creatomate 后台建 30s 5-beat 模板, 把 template id 填到下面.
CREATOMATE_API_KEY=
CREATOMATE_BASE_URL=https://api.creatomate.com/v2
CREATOMATE_TEMPLATE_ID=creatomate-builtin-30s-5beats
CREATOMATE_POLL_MS=3000
CREATOMATE_POLL_TIMEOUT_MS=600000

# TTS still optional (视频不出配音). 配齐时 encode-creatomate 会读 script.json
# beats.tts_text 拼接合成中文配音音轨.
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=eastasia

# P1: Trigger.dev v4 self-hosted (default RUN_TRIGGER_DEV=1 since PR3; PR4 已删 BullMQ)
# TRIGGER_PROJECT_REF=
# TRIGGER_SECRET_KEY=
# TRIGGER_API_URL=http://trigger-web:3030
# TRIGGER_DEPLOYMENT=self-hosted
RUN_TRIGGER_DEV=1
