# auto-explainer-saas — env reference
# ============================================================================
# Copy to .env.local and fill in. Keys marked [REQUIRED] must be set (schema
# enforces via lib/env.ts Zod parse at server startup). All others have safe
# defaults or are optional with .or(z.literal('')) — leaving them blank disables
# the corresponding feature (TTS, fallback, webhook, etc.).
#
# Sections:
#   §1  Required (lib/env.ts schema mandatory)
#   §2  Database / Cache connection
#   §3  LLM providers (Anthropic default + OpenRouter fallback)
#   §4  Render path (Creatomate SaaS)
#   §5  TTS (Azure Speech, optional)
#   §6  Trigger.dev v4 self-hosted (v0.5+)
#   §7  HTTP basic auth + ops knobs
#
# Verify schema: after copy, run `npm run dev` once; server crashes on
# missing required keys with `[env] Invalid env:` log line.
# ============================================================================

# ─────────────────────────────────────────────────────────────────────────────
# §1 Required (server refuses to start without these)
# ─────────────────────────────────────────────────────────────────────────────

# LLM (Anthropic Claude — primary)
ANTHROPIC_API_KEY=sk-ant-...

# Render (Creatomate SaaS — primary render path, P0 全量 hard cut)
CREATOMATE_API_KEY=

# HTTP basic auth on /api/jobs (nginx in prod also gates)
BASIC_AUTH_USER=admin
BASIC_AUTH_PASS=changeme


# ─────────────────────────────────────────────────────────────────────────────
# §2 Database / Cache
# ─────────────────────────────────────────────────────────────────────────────

DATABASE_URL=postgres://postgres:postgres@localhost:5432/aesaas
REDIS_URL=redis://localhost:6379


# ─────────────────────────────────────────────────────────────────────────────
# §3 LLM providers (Anthropic default + OpenRouter fallback)
# ─────────────────────────────────────────────────────────────────────────────

# P2 OpenRouter fallback for MiniMax-M3.
# Leave OPENROUTER_API_KEY empty to disable fallback entirely (Anthropic only).
# OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_FALLBACK_MODEL=minimax/MiniMax-M3


# ─────────────────────────────────────────────────────────────────────────────
# §4 Render path (Creatomate SaaS — only render in v0.5+)
# ─────────────────────────────────────────────────────────────────────────────

CREATOMATE_BASE_URL=https://api.creatomate.com/v2
CREATOMATE_TEMPLATE_ID=creatomate-builtin-30s-5beats
CREATOMATE_POLL_MS=3000
CREATOMATE_POLL_TIMEOUT_MS=600000


# ─────────────────────────────────────────────────────────────────────────────
# §5 TTS (Azure Speech — optional; leave blank for silent video)
# ─────────────────────────────────────────────────────────────────────────────

# AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastasia


# ─────────────────────────────────────────────────────────────────────────────
# §6 Trigger.dev v4 self-hosted (since v0.5 PR3; BullMQ removed)
# ─────────────────────────────────────────────────────────────────────────────

# Get project_ref from https://trigger.dev dashboard after first push.
# TRIGGER_PROJECT_REF=
TRIGGER_SECRET_KEY=                     # ≥ 10 chars; auto-generate: openssl rand -hex 16
TRIGGER_API_URL=http://trigger-web:3030
TRIGGER_DEPLOYMENT=self-hosted          # self-hosted | cloud

# Toggle (default '1' since P1 PR3). Set '0' to opt-out (no-trigger mode).
RUN_TRIGGER_DEV=1


# ─────────────────────────────────────────────────────────────────────────────
# §7 Human-in-Loop webhook + ops knobs
# ─────────────────────────────────────────────────────────────────────────────

# Wall-hit notification (spec §4.4). Leave blank to skip webhook (still
# writes human_in_loop_reason column for dashboard filter).
# HUMAN_IN_LOOP_WEBHOOK_URL=

# Runtime + log
NODE_ENV=development                     # development | production | test
LOG_LEVEL=info                           # fatal | error | warn | info | debug | trace
